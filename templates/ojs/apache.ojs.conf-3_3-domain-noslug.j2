## Template: ojs/apache.ojs.conf-3_3-domain-noslug.j2
##
## This set of rules were created for single-tenant journals installed in a domain
## or a subdomain's root with the journalContext hidden (ie: https://subdomain.foo.org)
## behind a reverse proxy, but running in a container without ssl.
##
## Some notes:
## - Non final redirections need to be 307.
## - Conflictive redirections include the protocol (httpS) to avoid "mixed content".
## - API calls are captured to be redirected to site or journal.
## - Root folder is for the journal (single-tenant).
## - Admin pages are redirected to /index subfolder.
##
## Journal root is: {{ allVars.pkp.general.base_url_journal }}
## Site's root is:  {{ allVars.pkp.general.base_url_index }}

# Load modules
LoadModule slotmem_shm_module modules/mod_slotmem_shm.so
LoadModule rewrite_module modules/mod_rewrite.so
LoadModule expires_module modules/mod_expires.so
LoadModule headers_module modules/mod_headers.so

# Trick 01: Force HTTPS detection and schema when behind a reverse proxy
SetEnvIf X-Forwarded-Proto "https" HTTPS=on
SetEnvIf X-Forwarded-Proto "https" REQUEST_SCHEME=https

<VirtualHost *:80>
    ServerName localhost
    ServerAlias {{ allVars.dojo.domain }}
    ServerAlias {{ allVars.dojo.id }}

    RewriteEngine On
    AcceptPathInfo On

    # Trick 02: Rewrite any Location header from http to https to avoid mixed content
    Header edit Location "^http://(.*)$" "https://$1"

    DocumentRoot /var/www/html

    <Directory /var/www/html>
        Options FollowSymLinks
        AllowOverride all
        Require all granted
        DirectoryIndex index.php index.html

        RewriteBase /

{% if allVars.pkp.general.installed | default('Off') == 'On' %}
        #########################################################
        # Rules for a domain/subdomain journal installed at root
        #########################################################

        # Trick 03: Redirect domain root to /index (so internal rewrite works)
        RewriteRule ^/?$ https://{{ allVars.dojo.domain }}/index [L,R=307]

        # Trick 04: Redirect journal API calls (without duplicating the id)
        RewriteCond %{REQUEST_URI} ^/api/v1
        RewriteCond %{REQUEST_FILENAME} !-f
        RewriteRule ^(.*)$ https://{{ allVars.dojo.domain }}/index.php/{{ allVars.dojo.id }}/$1 [QSA,L,R=307]

        # Redirect new _API calls (sitewide, used for public endpoints)
        RewriteCond %{REQUEST_URI} ^/_/api/v1/
        RewriteCond %{REQUEST_FILENAME} !-f
        RewriteRule ^(.*)$ https://{{ allVars.dojo.domain }}/index.php/$1 [QSA,L,R=307]

        #########################################################
        # Rewrite clean URLs for the journal (noslug mode)
        # Exclude routes starting with /index/ or containing /index.php
        #########################################################

        # Trick 05: Separate rewrite rules for journal content and admin pages

        # For routes that are NOT admin (journal)
        RewriteCond %{REQUEST_URI} !^/index/
        RewriteCond %{REQUEST_URI} !/index.php
        RewriteCond %{REQUEST_FILENAME} !-d
        RewriteCond %{REQUEST_FILENAME} !-f
        RewriteRule ^(.*)$ index.php/{{ allVars.dojo.id }}/$1 [QSA,L]

        # For admin routes (RESTful): /index/admin, /index/oai, etc.
        # Rewrite internally to index.php/index/... (no external redirect)
        RewriteCond %{REQUEST_URI} ^/index/
        RewriteCond %{REQUEST_FILENAME} !-d
        RewriteCond %{REQUEST_FILENAME} !-f
        RewriteRule ^index/(.*)$ index.php/index/$1 [QSA,L]

        # NOTE: URLs already containing /index.php will not be modified by any rule,
        # because conditions explicitly exclude /index.php.

{% else %}
        ########################
        # Rules for INSTALL
        ########################

        # $$$call$$ redirection to journal (required by OJS installer)
        RewriteCond %{REQUEST_URI} ^\/\$\$\$call\$\$\$
        RewriteRule ^(.*)$ https://{{ allVars.dojo.domain }}/index.php/{{ allVars.dojo.id }}/$1 [L,R=307]

        # Remove index.php from the url (standard OJS rewrite during install)
        RewriteCond %{REQUEST_URI} !/index.php
        RewriteCond %{REQUEST_FILENAME} !-d
        RewriteCond %{REQUEST_FILENAME} !-f
        RewriteRule ^(.*)$ index.php/$1 [QSA,L]
{% endif %}

    </Directory>

    ErrorLog  /var/log/apache2/error.log
    CustomLog  /var/log/apache2/access.log combined
</VirtualHost>

